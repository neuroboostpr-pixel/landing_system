# ─────────── ПУТЬ К ПАПКЕ С ПРОЕКТАМИ (необязательно) ───────────
# По умолчанию ищется автоматически в таком порядке:
#   1. ../Lendings рядом с landing_system (типичная установка)
#   2. ~/Lendings (домашняя папка)
# Указать явно если у тебя другая структура папок.
# LANDINGS_ROOT=/home/user/work/Lendings
# LANDINGS_ROOT=d:/AI_TEAMS/Lendings

# ─────────── ПАРСИНГ И РЕСЁРЧ ───────────
