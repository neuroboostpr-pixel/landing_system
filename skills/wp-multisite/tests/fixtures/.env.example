# Test environment for skills/wp-multisite/tests/
# Copy to .env and fill real values to run integration tests against live Beget.
#
# NOTE on login credentials:
#   BEGET_LOGIN is for API access (Account → API password section).
#   BEGET_USER  is for SSH access (Account → SSH access section).
#   They are usually the same value but may differ — check your Beget account settings.
BEGET_USER="esper21"
BEGET_HOST="esper21.beget.tech"
BEGET_LOGIN="esper21"
BEGET_PASSWD="YOUR_BEGET_API_PASSWORD"
BEGET_API="https://api.beget.com/api"
BEGET_SSH_KEY="$HOME/.ssh/beget_poc"
BEGET_DOMAIN_ID=000000000  # YOUR domain ID — get via 'beget_api domain/getList'
TEST_ROOT_DOMAIN="ailexi.ru"
